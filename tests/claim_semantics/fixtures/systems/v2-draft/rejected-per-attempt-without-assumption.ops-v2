; rejected-by: R-ASSUME
; docs/ir-specification.md section 7. A per-attempt operation is admitted only
; when the system declares [assume "atomic-publish-v1"], the assumption under
; which its info outcome has exactly the alternatives {nothing, everything}.
; Here it is missing, so the per-attempt operation's info semantics is
; undefined.
[system-v2 "per-attempt-without-assumption"
 []
 [[table "item" ["status"] [] []]]
 []
 [[operation "close" ["id"] [per-attempt]
   [exists "item" [argument "id"]]
   [[transaction "body" [[named "close" [update "item" [argument "id"] "status" [literal "closed"]]]]]]
   [yes]]]
 []
