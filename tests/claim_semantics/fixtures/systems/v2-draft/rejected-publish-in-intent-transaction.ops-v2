; rejected-by: T-action-v2
; docs/ir-specification.md section 4.3. An operation with intent identity
; uses publish inside its transaction. caps-action-v2 admits a v1 action only
; when it does not publish (capsv2.publishes?): an operation with intent
; identity states its external effect as [outbox ...] plus [deliver ...], and
; atomic publish stays confined to per-attempt operations.
[system-v2 "publish-in-intent-transaction"
 []
 [[table "job" ["payload"] [] []]]
 []
 [[operation "send" ["id"] [intent [argument "id"]]
   [exists "job" [argument "id"]]
   [[transaction "record"
     [[named "send" [publish "delivery-attempt" [lookup "job" [argument "id"] "payload"]]]]]]
   [yes]]]
 []
 []
 []]
