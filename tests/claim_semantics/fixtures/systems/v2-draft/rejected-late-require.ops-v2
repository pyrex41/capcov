; rejected-by: R-LATE-REJECT
; docs/ir-specification.md section 4.1. The ok arm's transaction can reject.
; It runs after the first transaction committed and an attempt was sent, so
; the invocation can no longer truthfully complete fail: something already
; happened. A transaction that is not an operation's first step may contain
; no require and no insert.
[system-v2 "late-require"
 []
 [[table "job" ["payload"] [] []]
  [outbox-table "outbox" "delivery-attempt"]]
 [[channel "delivery-attempt" [at-most-once]]]
 [[operation "relay" ["id"] [intent [argument "id"]]
   [exists "outbox" [argument "id"]]
   [[deliver "publish" "outbox" [intent [argument "id"]]
     [ok [[transaction "settle"
       [[named "still-there" [require "job-missing" [exists "job" [argument "id"]]]]
        [named "mark-delivered" [update "outbox" [argument "id"] "state" [literal "delivered"]]]]]]]
     [fail []]
     [info []]]]
   [yes]]]
 []
 []
 []]
