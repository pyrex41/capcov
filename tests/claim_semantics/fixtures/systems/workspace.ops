[system "workspace"
 [[table "account" ["name"] ["name"] []]
  [table "item" ["owner" "status" "title"] [] [[foreign "owner" "account"]]]]
 [[command "create" ["actor" "id" "title"]
   [both [exists "account" [argument "actor"]] [negate [exists "item" [argument "id"]]]]
   [[named "insert" [insert "item" [argument "id"]
     [["owner" [argument "actor"]] ["status" [literal "open"]] ["title" [argument "title"]]]]]
    [named "created" [publish "item-created" [argument "id"]]]]
   [exists "item" [argument "id"]]]
  [command "rename" ["actor" "id" "title"]
   [both [exists "item" [argument "id"]]
         [equal [lookup "item" [argument "id"] "owner"] [argument "actor"]]]
   [[named "rename" [update "item" [argument "id"] "title" [argument "title"]]]]
   [equal [lookup "item" [argument "id"] "title"] [argument "title"]]]
  [command "close" ["actor" "id"]
   [both [exists "item" [argument "id"]]
         [equal [lookup "item" [argument "id"] "owner"] [argument "actor"]]]
   [[named "once" [choose [equal [lookup "item" [argument "id"] "status"] [literal "open"]]
     [[named "close" [update "item" [argument "id"] "status" [literal "closed"]]]
      [named "closed" [publish "item-closed" [argument "id"]]]]
     []]]]
   [equal [lookup "item" [argument "id"] "status"] [literal "closed"]]]
  [command "delete-account" ["actor"]
   [exists "account" [argument "actor"]]
   [[named "children" [for-each "item" [equal [row-field "owner"] [argument "actor"]]
     [[named "delete-child" [remove "item" [row-key]]]]]]
    [named "delete-account" [remove "account" [argument "actor"]]]]
   [negate [exists "account" [argument "actor"]]]]]
 [["legal-status" [every-row "item"
   [either [equal [row-field "status"] [literal "open"]]
           [equal [row-field "status"] [literal "closed"]]]]]]]
