include capcov.toml capcov.outcomes.json uv.lock
recursive-include scripts *.sh
recursive-include tests *.py *.patch
recursive-include src/capcov/claims/static *.json
recursive-include src/capcov/claims/replay *.json
recursive-include src/capcov/claims/observation *.json
recursive-include src/capcov/faults *.json
include tests/fixtures/rea-api-view.json tests/fixtures/rea-api-view.README.md
include src/capcov_contrib/REA.md

recursive-include src/capcov/operations *.shen
recursive-include src/capcov/operations *.dl
recursive-include tests/claim_semantics/fixtures/operations *.op *.json
recursive-include tests/claim_semantics/fixtures/systems *.ops *.json
