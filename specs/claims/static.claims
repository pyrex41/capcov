.claims 2.
// Authored finite logic. Closure contracts are elaborated by Shen.
.pack "rules-static-v2" schema 2 description "SCIP -> Datalog static rule pack (EXPERIMENT-PLAN section 29). `primitives` is a byte-identical copy of claims/static/schema_static_v1.json; `supplementary_primitives` declares the runtime observation and assumptions the section names outside the frozen file; `derived` and `rules` are the reviewed program in raw IR JSON wire form." primitives_source "packages/capabilities/src/capcov/claims/static/schema_static_v1.json".

.import "static-relations.claims".

// Reviewed closure derivations retain their full premise lists.

.policy static_route_authorized_closed-policy rule static_route_authorized_closed completes static_route_authorized_closed digest "ef9a17d05bcbefc2305aca5de675c7d880d7adba47a96892618e2efb6cd84f74".

scip_document_path: scip_document_path(IX, P) :-
    scip_document(IX, P, Lang, OccCount, SymCount, Synth).
scip_definition_site_at: scip_definition_site_at(IX, P, L) :-
    scip_definition_site(IX, P, L, Sym).
static_edge: static_edge(IX, Src, Dst) :-
    scip_may_reference(IX, Src, Dst, P, L, Occ, CallerSynth).
static_route_declared_surface: static_route_declared_surface(IX, S) :-
    route_site(IX, S, P, L, HandlerName).
static_route_handler: static_route_handler(IX, S, Sym) :-
    route_handler_location(IX, S, F, L), scip_definition_site(IX, F, L, Sym), scip_symbol(IX, Sym, Kind, "callable"::symbol, Display).
static_root: static_root(IX, H) :-
    static_route_handler(IX, S, H).
static_reaches_base: static_reaches(IX, Root, Dst) :-
    static_root(IX, Root), static_edge(IX, Root, Dst).
static_reaches_step: static_reaches(IX, Root, Dst) :-
    static_reaches(IX, Root, Mid), static_edge(IX, Mid, Dst).
static_reaches_eq_refl: static_reaches_eq(IX, Root, Root) :-
    static_root(IX, Root).
static_reaches_eq_step: static_reaches_eq(IX, Root, Dst) :-
    static_reaches(IX, Root, Dst).
static_op_owner: static_op_owner(IX, Sym, E, Verb) :-
    static_op_site(IX, F, L, Verb, E), static_site_owner(IX, F, L, Sym).
static_path_to_storage: static_path_to_storage(IX, S, E, Verb) :-
    static_route_handler(IX, S, H), static_reaches_eq(IX, H, N), static_op_owner(IX, N, E, Verb).
static_index_current: static_index_current(IX) :-
    scip_index_tree(IX, T, FileCount, Pattern), source_tree_observed(T).
scip_index_stale: scip_index_stale(IX, T, Observed) :-
    scip_index_tree(IX, T, FileCount, Pattern), source_tree_observed(Observed), T != Observed.
static_capability_op: static_capability_op(IX, S, E, Verb) :-
    static_path_to_storage(IX, S, E, Verb), static_index_current(IX).
static_capability: static_capability(IX, S, E, Verb) :-
    static_capability_op(IX, S, E, Verb), scip_index(IX, Indexer, IndexerVersion, Lang, ProjectRoot, DigestKind).
static_file_unindexed: static_file_unindexed(IX, P) :-
    static_source_file(IX, P, Lang), !scip_document_path(IX, P).
scip_duplicate_definition_path: scip_duplicate_definition(IX, Sym, PA, LA, PB, LB) :-
    scip_definition_site(IX, PA, LA, Sym), scip_definition_site(IX, PB, LB, Sym), scip_symbol(IX, Sym, Kind, Cat, Display), Cat != "other"::symbol, PA != PB.
scip_duplicate_definition_line: scip_duplicate_definition(IX, Sym, PA, LA, PB, LB) :-
    scip_definition_site(IX, PA, LA, Sym), scip_definition_site(IX, PB, LB, Sym), scip_symbol(IX, Sym, Kind, Cat, Display), Cat != "other"::symbol, LA != LB.
change_reaches_base: change_reaches(IX, Changed, Caller) :-
    changed_symbol(IX, Changed, ChangeKind), static_edge(IX, Caller, Changed).
change_reaches_step: change_reaches(IX, Changed, Caller) :-
    change_reaches(IX, Changed, Mid), static_edge(IX, Caller, Mid).
affected_capability_direct: affected_capability(IX, S, Changed) :-
    static_route_handler(IX, S, Changed), changed_symbol(IX, Changed, ChangeKind), static_index_current(IX).
affected_capability_reaches: affected_capability(IX, S, Changed) :-
    static_route_handler(IX, S, H), change_reaches(IX, Changed, H), static_index_current(IX).
runtime_route_without_static: runtime_route_without_static(T, S, Run, IX) :-
    runtime_route_observed(T, S, Event, Run), index_describes_run(IX, Run), !static_route_declared_surface(IX, S).
static_route_authorized: static_route_authorized(IX, S) :-
    static_route_handler(IX, S, H), static_reaches_eq(IX, H, N), authz_symbol__accepted(IX, N), static_index_current(IX).
static_route_authorized_closed: static_route_authorized_closed(IX) :-
    static_reachability_closed(IX), static_route_inventory_closed(IX), static_index_current(IX).
static_route_authorization_gap: static_route_authorization_gap(IX, S) :-
    static_route_declared_surface(IX, S), !static_route_authorized(IX, S).
