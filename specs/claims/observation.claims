.claims 2.
// Authored finite logic. Closure contracts are elaborated by Shen.
.pack "rules-observation-v1" schema 1 description "The reviewed rule pack for observations_agree(run, check, scenario_set, policy) and incumbent_stable(run) (Lane A). observations_agree says only that, on the scenarios the admitted set declares, the incumbent and the candidate were observed to answer alike under the admitted comparison policy -- it is NOT a correctness claim and not a capability-parity claim. NO MODEL RELATION IS DECLARED: neither this pack nor schema_observation_v1.json declares a model relation or a model producer class, so the claim is model-free BY CONSTRUCTION; and model_conformance_unassessed is a POSITIVE, CLOSED premise, so the claim does not derive unless the receipt states in exported rows that it assessed no model. A receipt that carries a model belongs to op_qualified in the replay pack, not here. There is NO experiments/claim-semantics mirror of this pack in v1 -- there is no corpus adapter for observation receipts yet, so this shipped file is the only copy and nobody should look for a second one. Every relation is runtime-bound, so no static/runtime compatibility witness is needed or declared (a compatibility relation here would be ceremony a later reader would mistake for a gate). The receipt's source binding is a context-free reviewer observation joined on a column of the run row, exactly as replay_run_current binds a snapshot. C4 (one-sided masks): observation_body_raw is read by body_masked, which holds where a scenario's two raw body digests differ while its two normalized body digests match -- a real wire difference that a normalization erased, on one side or on both. observation_mask_undisclosed holds where such a scenario has no observation_masked_difference row for the body facet, and observations_agree negates it under observation_mask_disclosure_closed. This is the judge's own copy of the exporter's R-9: an erased difference that reached the bundle undisclosed blocks the claim here even if it was not refused at ingest." primitives_source "packages/capabilities/src/capcov/claims/observation/schema_observation_v1.json".

.decl observation_run(run: symbol ctx, nonce: digest, check: symbol, candidate_commit: symbol, incumbent_commit: symbol, source_digest: digest, fixture: digest, scenario_set: digest, policy: digest) primitive observation runtime finite nonempty producers(observe).
.decl observation_scenario(run: symbol ctx, scenario: symbol, kind: symbol, required: symbol, expected_class: symbol) primitive observation runtime producers(observe).
.decl observation_observed(run: symbol ctx, scenario: symbol, side: symbol) primitive observation runtime producers(observe).
.decl observation_unobserved(run: symbol ctx, scenario: symbol, side: symbol, reason: symbol) primitive observation runtime producers(observe).
.decl observation_status(run: symbol ctx, scenario: symbol, side: symbol, status: unsigned) primitive observation runtime producers(observe).
.decl observation_class(run: symbol ctx, scenario: symbol, side: symbol, class: symbol) primitive observation runtime producers(observe).
.decl observation_body(run: symbol ctx, scenario: symbol, side: symbol, body_digest: digest) primitive observation runtime producers(observe).
.decl observation_body_raw(run: symbol ctx, scenario: symbol, side: symbol, raw_digest: digest) primitive observation runtime producers(observe).
.decl observation_effects(run: symbol ctx, scenario: symbol, side: symbol, effects_digest: digest) primitive observation runtime producers(observe).
.decl observation_normalization(run: symbol ctx, scenario: symbol, side: symbol, facet: symbol, normalization: symbol, before_digest: digest, after_digest: digest) primitive observation runtime producers(observe).
.decl observation_masked_difference(run: symbol ctx, scenario: symbol, facet: symbol, normalization: symbol, field_path: symbol) primitive observation runtime producers(observe).
.decl observation_policy_entry(policy: digest ctx, entry_kind: symbol, id: symbol, facet: symbol, target: symbol, preserves: symbol, source_sha256: digest) primitive observation runtime producers(observe).
.decl observation_terminal(run: symbol ctx, outcome: symbol) primitive observation runtime producers(observe).
.decl observation_failure(run: symbol ctx, phase: symbol, failure_class: symbol) primitive observation runtime producers(observe).
.decl observation_unassessed(run: symbol ctx, dimension: symbol, reason: symbol) primitive observation runtime nonempty producers(observe).
.decl observation_stability(run: symbol ctx, run_a: symbol, run_b: symbol, side: symbol, stable: symbol) primitive observation runtime producers(observe).
.decl observation_nonce_observed(run: symbol, nonce: digest) primitive observation runtime producers(reviewer).
.decl observation_source_observed(source_digest: digest) primitive observation runtime producers(reviewer).
.decl observation_fixture_observed(fixture: digest) primitive observation runtime producers(reviewer).
.decl policy_admitted(policy: digest ctx, reviewer: symbol, version: symbol) primitive assumption runtime producers(reviewer).
.decl scenario_set_admitted(scenario_set: digest ctx, check: symbol, reviewer: symbol, version: symbol) primitive assumption runtime producers(reviewer).
.decl masked_difference_admitted(policy: digest ctx, normalization: symbol, field_path: symbol, reviewer: symbol) primitive assumption runtime producers(reviewer).
.decl observation_scenarios_closed(run: symbol ctx) primitive completeness runtime completes observation_scenario producers(observe).
.decl observation_observed_closed(run: symbol ctx, side: symbol) primitive completeness runtime completes observation_observed producers(observe).
.decl observation_unobserved_closed(run: symbol ctx) primitive completeness runtime completes observation_unobserved producers(observe).
.decl observation_statuses_closed(run: symbol ctx, side: symbol) primitive completeness runtime completes observation_status producers(observe).
.decl observation_classes_closed(run: symbol ctx, side: symbol) primitive completeness runtime completes observation_class producers(observe).
.decl observation_bodies_closed(run: symbol ctx, side: symbol) primitive completeness runtime completes observation_body producers(observe).
.decl observation_effects_closed(run: symbol ctx, side: symbol) primitive completeness runtime completes observation_effects producers(observe).
.decl observation_normalizations_closed(run: symbol ctx) primitive completeness runtime completes observation_normalization producers(observe).
.decl observation_masked_closed(run: symbol ctx) primitive completeness runtime completes observation_masked_difference producers(observe).
.decl observation_failures_closed(run: symbol ctx) primitive completeness runtime completes observation_failure producers(observe).
.decl observation_unassessed_closed(run: symbol ctx) primitive completeness runtime completes observation_unassessed producers(observe).
.decl observation_stability_closed(run: symbol ctx) primitive completeness runtime completes observation_stability producers(observe).
.decl observation_policy_closed(policy: digest ctx) primitive completeness runtime completes observation_policy_entry producers(observe).
.decl masked_admissions_closed(policy: digest ctx) primitive completeness runtime completes masked_difference_admitted producers(reviewer).
.decl scenario_observed(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl scenario_observed_closed(run: symbol ctx) derived completeness runtime completes scenario_observed.
.decl scenario_declared(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl scenario_declared_closed(run: symbol ctx) derived completeness runtime completes scenario_declared.
.decl observation_run_current(run: symbol ctx) derived derived runtime.
.decl policy_bound(run: symbol ctx, policy: digest) derived derived runtime.
.decl set_bound(run: symbol ctx, scenario_set: digest) derived derived runtime.
.decl check_completed(run: symbol ctx) derived derived runtime.
.decl model_conformance_unassessed(run: symbol ctx) derived derived runtime.
.decl set_exercised(run: symbol ctx) derived derived runtime.
.decl status_disagree(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl body_disagree(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl effects_disagree(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl scenario_disagree(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl observation_disagree_any(run: symbol ctx) derived derived runtime.
.decl observation_disagreement_closed(run: symbol ctx) derived completeness runtime completes observation_disagree_any.
.decl scenario_uncompared(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl scenario_setup_failed(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl scenario_timed_out(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl scenario_errored(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl observation_gap_any(run: symbol ctx) derived derived runtime.
.decl observation_gap_closed(run: symbol ctx) derived completeness runtime completes observation_gap_any.
.decl scenario_degenerate(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl observation_degenerate_any(run: symbol ctx) derived derived runtime.
.decl observation_degenerate_closed(run: symbol ctx) derived completeness runtime completes observation_degenerate_any.
.decl policy_normalization(policy: digest ctx, id: symbol) derived derived runtime.
.decl policy_normalization_closed(policy: digest ctx) derived completeness runtime completes policy_normalization.
.decl normalization_undeclared(run: symbol ctx, normalization: symbol) derived derived runtime.
.decl observation_undeclared_any(run: symbol ctx) derived derived runtime.
.decl observation_undeclared_closed(run: symbol ctx) derived completeness runtime completes observation_undeclared_any.
.decl scenario_undeclared(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl scenario_undeclared_any(run: symbol ctx) derived derived runtime.
.decl scenario_undeclared_closed(run: symbol ctx) derived completeness runtime completes scenario_undeclared_any.
.decl masked_admitted(policy: digest ctx, normalization: symbol, field_path: symbol) derived derived runtime.
.decl masked_admitted_closed(policy: digest ctx) derived completeness runtime completes masked_admitted.
.decl observation_masked_unadmitted(run: symbol ctx) derived derived runtime.
.decl observation_masked_gate_closed(run: symbol ctx) derived completeness runtime completes observation_masked_unadmitted.
.decl body_masked(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl body_mask_disclosed(run: symbol ctx, scenario: symbol) derived derived runtime.
.decl body_mask_disclosed_closed(run: symbol ctx) derived completeness runtime completes body_mask_disclosed.
.decl observation_mask_undisclosed(run: symbol ctx) derived derived runtime.
.decl observation_mask_disclosure_closed(run: symbol ctx) derived completeness runtime completes observation_mask_undisclosed.
.decl observation_failure_any(run: symbol ctx) derived derived runtime.
.decl observation_failure_gate_closed(run: symbol ctx) derived completeness runtime completes observation_failure_any.
.decl observation_unstable(run: symbol ctx) derived derived runtime.
.decl observation_unstable_closed(run: symbol ctx) derived completeness runtime completes observation_unstable.
.decl incumbent_stable(run: symbol ctx) derived derived runtime.
.decl observations_agree(run: symbol ctx, check: symbol, scenario_set: digest, policy: digest) derived derived runtime.
scenario_observed: scenario_observed(Run, S) :-
    observation_observed(Run, S, "incumbent"::symbol), observation_observed(Run, S, "candidate"::symbol).
scenario_observed_closed: scenario_observed_closed(Run) :-
    observation_observed_closed(Run, "incumbent"::symbol), observation_observed_closed(Run, "candidate"::symbol).
scenario_declared: scenario_declared(Run, S) :-
    observation_scenario(Run, S, Kind3, Req3, Class3).
scenario_declared_closed: scenario_declared_closed(Run) :-
    observation_scenarios_closed(Run).
observation_run_current: observation_run_current(Run) :-
    observation_run(Run, Nonce, Check5, Cand5, Inc5, Src, Fix, Set5, Pol5), observation_nonce_observed(Run, Nonce), observation_source_observed(Src), observation_fixture_observed(Fix).
policy_bound: policy_bound(Run, Pol) :-
    observation_run(Run, Nonce6, Check6, Cand6, Inc6, Src6, Fix6, Set6, Pol), policy_admitted(Pol, Reviewer6, Version6).
set_bound: set_bound(Run, Set) :-
    observation_run(Run, Nonce7, Check, Cand7, Inc7, Src7, Fix7, Set, Pol7), scenario_set_admitted(Set, Check, Reviewer7, Version7).
check_completed: check_completed(Run) :-
    observation_terminal(Run, "compared"::symbol).
model_conformance_unassessed: model_conformance_unassessed(Run) :-
    observation_unassessed(Run, "model_conformance"::symbol, Reason9), observation_unassessed_closed(Run).
set_exercised: set_exercised(Run) :-
    observation_scenario(Run, S, Kind10, Req10, Class10), scenario_observed(Run, S).
status_disagree_a: status_disagree(Run, S) :-
    scenario_observed(Run, S), observation_status(Run, S, "incumbent"::symbol, St), observation_statuses_closed(Run, "candidate"::symbol), !observation_status(Run, S, "candidate"::symbol, St).
status_disagree_b: status_disagree(Run, S) :-
    scenario_observed(Run, S), observation_status(Run, S, "candidate"::symbol, St), observation_statuses_closed(Run, "incumbent"::symbol), !observation_status(Run, S, "incumbent"::symbol, St).
body_disagree_a: body_disagree(Run, S) :-
    scenario_observed(Run, S), observation_body(Run, S, "incumbent"::symbol, Bd), observation_bodies_closed(Run, "candidate"::symbol), !observation_body(Run, S, "candidate"::symbol, Bd).
body_disagree_b: body_disagree(Run, S) :-
    scenario_observed(Run, S), observation_body(Run, S, "candidate"::symbol, Bd), observation_bodies_closed(Run, "incumbent"::symbol), !observation_body(Run, S, "incumbent"::symbol, Bd).
effects_disagree_a: effects_disagree(Run, S) :-
    scenario_observed(Run, S), observation_effects(Run, S, "incumbent"::symbol, Ed), observation_effects_closed(Run, "candidate"::symbol), !observation_effects(Run, S, "candidate"::symbol, Ed).
effects_disagree_b: effects_disagree(Run, S) :-
    scenario_observed(Run, S), observation_effects(Run, S, "candidate"::symbol, Ed), observation_effects_closed(Run, "incumbent"::symbol), !observation_effects(Run, S, "incumbent"::symbol, Ed).
scenario_disagree_status: scenario_disagree(Run, S) :-
    status_disagree(Run, S).
scenario_disagree_body: scenario_disagree(Run, S) :-
    body_disagree(Run, S).
scenario_disagree_effects: scenario_disagree(Run, S) :-
    effects_disagree(Run, S).
observation_disagree_any: observation_disagree_any(Run) :-
    scenario_disagree(Run, S).
observation_disagreement_closed: observation_disagreement_closed(Run) :-
    observation_run_current(Run), observation_scenarios_closed(Run), observation_observed_closed(Run, "incumbent"::symbol), observation_observed_closed(Run, "candidate"::symbol), observation_statuses_closed(Run, "incumbent"::symbol), observation_statuses_closed(Run, "candidate"::symbol), observation_bodies_closed(Run, "incumbent"::symbol), observation_bodies_closed(Run, "candidate"::symbol), observation_normalizations_closed(Run).
scenario_uncompared: scenario_uncompared(Run, S) :-
    observation_scenario(Run, S, Kind22, Req22, Class22), scenario_observed_closed(Run), !scenario_observed(Run, S).
scenario_setup_failed: scenario_setup_failed(Run, S) :-
    observation_unobserved(Run, S, Side23, "setup_failed"::symbol).
scenario_timed_out: scenario_timed_out(Run, S) :-
    observation_unobserved(Run, S, Side24, "timeout"::symbol).
scenario_errored: scenario_errored(Run, S) :-
    observation_unobserved(Run, S, Side25, "error"::symbol).
observation_gap_any_uncompared: observation_gap_any(Run) :-
    scenario_uncompared(Run, S).
observation_gap_any_unobserved: observation_gap_any(Run) :-
    observation_unobserved(Run, S, Side27, Reason27).
observation_gap_closed: observation_gap_closed(Run) :-
    observation_run_current(Run), observation_scenarios_closed(Run), observation_observed_closed(Run, "incumbent"::symbol), observation_observed_closed(Run, "candidate"::symbol), observation_unobserved_closed(Run).
scenario_degenerate: scenario_degenerate(Run, S) :-
    observation_scenario(Run, S, Kind29, Req29, EC), scenario_observed(Run, S), observation_classes_closed(Run, "incumbent"::symbol), !observation_class(Run, S, "incumbent"::symbol, EC).
observation_degenerate_any: observation_degenerate_any(Run) :-
    scenario_degenerate(Run, S).
observation_degenerate_closed: observation_degenerate_closed(Run) :-
    observation_run_current(Run), observation_scenarios_closed(Run), observation_observed_closed(Run, "incumbent"::symbol), observation_observed_closed(Run, "candidate"::symbol), observation_classes_closed(Run, "incumbent"::symbol).
policy_normalization: policy_normalization(Pol, Id) :-
    observation_policy_entry(Pol, "normalization"::symbol, Id, Facet32, Target32, Preserves32, Source32).
policy_normalization_closed: policy_normalization_closed(Pol) :-
    observation_policy_closed(Pol).
normalization_undeclared: normalization_undeclared(Run, N) :-
    observation_normalization(Run, S, Side34, Facet34, N, Before34, After34), observation_run(Run, Nonce34, Check34, Cand34, Inc34, Src34, Fix34, Set34, Pol), policy_normalization_closed(Pol), !policy_normalization(Pol, N).
observation_undeclared_any: observation_undeclared_any(Run) :-
    normalization_undeclared(Run, N).
observation_undeclared_closed: observation_undeclared_closed(Run) :-
    observation_run_current(Run), observation_normalizations_closed(Run), observation_run(Run, Nonce36, Check36, Cand36, Inc36, Src36, Fix36, Set36, Pol), observation_policy_closed(Pol).
scenario_undeclared: scenario_undeclared(Run, S) :-
    observation_observed(Run, S, Side37), scenario_declared_closed(Run), !scenario_declared(Run, S).
scenario_undeclared_any: scenario_undeclared_any(Run) :-
    scenario_undeclared(Run, S).
scenario_undeclared_closed: scenario_undeclared_closed(Run) :-
    observation_run_current(Run), observation_scenarios_closed(Run), observation_observed_closed(Run, "incumbent"::symbol), observation_observed_closed(Run, "candidate"::symbol).
masked_admitted: masked_admitted(Pol, N, FieldPath) :-
    masked_difference_admitted(Pol, N, FieldPath, Reviewer40).
masked_admitted_closed: masked_admitted_closed(Pol) :-
    masked_admissions_closed(Pol).
observation_masked_unadmitted: observation_masked_unadmitted(Run) :-
    observation_masked_difference(Run, S, Facet40, N, FieldPath), observation_run(Run, Nonce40, Check40, Cand40, Inc40, Src40, Fix40, Set40, Pol), masked_admitted_closed(Pol), !masked_admitted(Pol, N, FieldPath).
observation_masked_gate_closed: observation_masked_gate_closed(Run) :-
    observation_run_current(Run), observation_masked_closed(Run), observation_run(Run, Nonce41, Check41, Cand41, Inc41, Src41, Fix41, Set41, Pol), masked_admissions_closed(Pol).
body_masked: body_masked(Run, S) :-
    scenario_observed(Run, S), observation_body_raw(Run, S, "incumbent"::symbol, RawI), observation_body_raw(Run, S, "candidate"::symbol, RawC), RawI != RawC, observation_body(Run, S, "incumbent"::symbol, Bd), observation_body(Run, S, "candidate"::symbol, Bd).
body_mask_disclosed: body_mask_disclosed(Run, S) :-
    observation_masked_difference(Run, S, "body"::symbol, N50, FieldPath50).
body_mask_disclosed_closed: body_mask_disclosed_closed(Run) :-
    observation_masked_closed(Run).
observation_mask_undisclosed: observation_mask_undisclosed(Run) :-
    body_masked(Run, S), body_mask_disclosed_closed(Run), !body_mask_disclosed(Run, S).
observation_mask_disclosure_closed: observation_mask_disclosure_closed(Run) :-
    observation_run_current(Run), observation_masked_closed(Run), observation_bodies_closed(Run, "incumbent"::symbol), observation_bodies_closed(Run, "candidate"::symbol).
observation_failure_any_setup: observation_failure_any(Run) :-
    observation_failure(Run, Phase42, "setup"::symbol).
observation_failure_any_timeout: observation_failure_any(Run) :-
    observation_failure(Run, Phase43, "timeout"::symbol).
observation_failure_any_internal: observation_failure_any(Run) :-
    observation_failure(Run, Phase44, "internal"::symbol).
observation_failure_gate_closed: observation_failure_gate_closed(Run) :-
    observation_run_current(Run), observation_failures_closed(Run).
observation_unstable: observation_unstable(Run) :-
    observation_stability(Run, RunA46, RunB46, Side46, "false"::symbol).
observation_unstable_closed: observation_unstable_closed(Run) :-
    observation_stability_closed(Run).
incumbent_stable: incumbent_stable(Run) :-
    observation_stability(Run, RunA48, RunB48, "incumbent"::symbol, "true"::symbol), observation_stability_closed(Run), observation_unstable_closed(Run), !observation_unstable(Run).
observations_agree: observations_agree(Run, Check, Set, Pol) :-
    observation_run(Run, Nonce49, Check, Cand49, Inc49, Src49, Fix49, Set, Pol), observation_run_current(Run), policy_bound(Run, Pol), set_bound(Run, Set), check_completed(Run), model_conformance_unassessed(Run), observation_failure_gate_closed(Run), !observation_failure_any(Run), observation_gap_closed(Run), !observation_gap_any(Run), set_exercised(Run), observation_degenerate_closed(Run), !observation_degenerate_any(Run), observation_undeclared_closed(Run), !observation_undeclared_any(Run), scenario_undeclared_closed(Run), !scenario_undeclared_any(Run), observation_masked_gate_closed(Run), !observation_masked_unadmitted(Run), observation_disagreement_closed(Run), !observation_disagree_any(Run), observation_mask_disclosure_closed(Run), !observation_mask_undisclosed(Run).
