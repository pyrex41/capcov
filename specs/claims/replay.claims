.claims 2.
// Authored finite logic. Closure contracts are elaborated by Shen.
.pack "rules-replay-v2" schema 2 description "Replay judge rule pack (Phase 4, judge side). `primitives` is a byte-identical copy of claims/replay/schema_replay_v1.json; `supplementary_primitives` is empty (the frozen file declares every primitive the judge reads); `derived` opens with the two rule-less stubs the exporter carries (mutant_killed_in, op_qualified_rt), byte-identical to replay_facts._DERIVED_TARGET_DECLS so combine() accepts both, then the reviewed program; `rules` are in raw IR JSON wire form. op_qualified(index, run, op) is the qualification claim and the only static/runtime join, witnessed by index_describes_replay; repeat_delete_not_found(run, target) is the per-target cross-request claim. The checker-authority premises (model_well_formed, model_operation_checked, model_checker_admitted) sit last in op_qualified_rt's body -- the model fact is structural, while the operation fact and reviewer admission join the exact operation-scoped tuple; the why-not walk reports checker authority only after earlier system and model gaps. op_qualified_rt is additionally gated on the model's declared effect order (effect_order_*), on the repeat delete being not-found without effects (repeat_delete_closed / !repeat_delete_any: a second DELETE of a committed target that answers anything but 404 on either side, or writes any row outside the reviewer's scope exclusions, blocks the op it belongs to) and on the PHP oracle's cross-run stability (oracle_stable). A learn receipt, when one is bound to the run, is judged too: learn_consistent(run, op) says the model's predictions matched the oracle's observations for that op under both closures, and op_qualified_rt is downgraded by !learn_unmodeled_any -- an op the learn campaign reported as unmodelled does not qualify.  The downgrade can only take qualification away: a receipt with no learn files carries no learn_run row, derives no learn_unmodeled_any, and qualifies exactly as before. Operation qualification now joins the exact checked-operation tuple (model, operation, checker, semantic version, checker binary digest, semantic certificate digest) to an external reviewer admission; model_well_formed is structural validation only." primitives_source "packages/capabilities/src/capcov/claims/replay/schema_replay_v1.json".

.decl replay_run(run: symbol ctx, nonce: digest, php_commit: symbol, go_commit: symbol, snapshot: digest, model: digest) primitive observation runtime finite nonempty producers(replay).
.decl replay_request(run: symbol ctx, req: symbol, tenant: symbol, route: symbol, op: symbol) primitive observation runtime producers(replay).
.decl php_post_state(run: symbol ctx, req: symbol, state_digest: digest) primitive observation runtime producers(php).
.decl go_post_state(run: symbol ctx, req: symbol, state_digest: digest) primitive observation runtime producers(go).
.decl php_effect(run: symbol ctx, req: symbol, table: symbol, kind: symbol, pk: digest, cols_digest: digest) primitive observation runtime producers(php).
.decl go_effect(run: symbol ctx, req: symbol, table: symbol, kind: symbol, pk: digest, cols_digest: digest) primitive observation runtime producers(go).
.decl model_effect(run: symbol ctx, model: digest, req: symbol, table: symbol, kind: symbol, pk: digest, cols_digest: digest) primitive observation runtime producers(shen).
.decl model_admissible(run: symbol ctx, model: digest, req: symbol, state_digest: digest) primitive observation runtime producers(shen).
.decl model_writes(model: digest ctx, op: symbol, table: symbol) primitive observation runtime producers(shen).
.decl mutant(model: digest ctx, mutant: symbol, op: symbol) primitive observation runtime producers(mut).
.decl mutant_killed(run: symbol ctx, mutant: symbol, req: symbol) primitive observation runtime producers(mut).
.decl php_effect_seq(run: symbol ctx, req: symbol, seq: unsigned, table: symbol, kind: symbol, pk: digest) primitive observation runtime producers(php).
.decl go_effect_seq(run: symbol ctx, req: symbol, seq: unsigned, table: symbol, kind: symbol, pk: digest) primitive observation runtime producers(go).
.decl model_effect_seq(run: symbol ctx, model: digest, req: symbol, seq: unsigned, table: symbol, kind: symbol, pk: digest) primitive observation runtime producers(shen).
.decl replay_request_seq(run: symbol ctx, req: symbol, seq: unsigned, target: symbol) primitive observation runtime producers(replay).
.decl php_response(run: symbol ctx, req: symbol, status: unsigned) primitive observation runtime producers(php).
.decl go_response(run: symbol ctx, req: symbol, status: unsigned) primitive observation runtime producers(go).
.decl replay_stability(run: symbol ctx, run_a: symbol, run_b: symbol, side: symbol, stable: symbol) primitive observation runtime producers(replay).
.decl model_well_formed(model: digest ctx, checker: symbol, checker_version: symbol, checker_binary: digest, certificate: digest) primitive observation runtime producers(modelcheck).
.decl model_operation_checked(model: digest ctx, operation: symbol ctx, checker: symbol, checker_version: symbol, checker_binary: digest, certificate: digest) primitive observation runtime producers(modelcheck).
.decl model_scope_exclusion(model: digest ctx, table: symbol, reason: symbol) primitive assumption runtime producers(reviewer).
.decl run_nonce_observed(run: symbol, nonce: digest) primitive observation runtime producers(reviewer).
.decl snapshot_observed(snapshot: digest) primitive observation runtime producers(reviewer).
.decl model_observed(model: digest) primitive observation runtime producers(reviewer).
.decl model_checker_admitted(model: digest ctx, operation: symbol ctx, checker: symbol, checker_version: symbol, checker_binary: digest, certificate: digest) primitive observation runtime producers(reviewer).
.decl learn_run(run: symbol ctx, campaign: symbol, model: digest, learn: digest, php_commit: symbol, snapshot: digest) primitive observation runtime producers(replay).
.decl learn_prediction(run: symbol ctx, model: digest, learn: digest, tape: symbol, req: symbol, op: symbol, predicted: symbol, state_digest: digest) primitive observation runtime producers(shen).
.decl learn_observation(run: symbol ctx, tape: symbol, req: symbol, op: symbol, observed: symbol, state_digest: digest) primitive observation runtime producers(php).
.decl learn_unmodeled(model: digest ctx, learn: digest, op: symbol) primitive observation runtime producers(shen).
.decl op_declared(index: digest ctx, op: symbol) primitive observation static producers(php-census).
