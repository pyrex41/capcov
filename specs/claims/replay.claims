mutant_killed_in: mutant_killed_in(Run, Mu) :-
    mutant_killed(Run, Mu, Req).
replay_run_current: replay_run_current(Run) :-
    replay_run(Run, Nonce, PhpCommit, GoCommit, Snap, Model), run_nonce_observed(Run, Nonce), snapshot_observed(Snap), model_observed(Model).
replay_run_stale: replay_run_stale(Run, Nonce, Observed) :-
    replay_run(Run, Nonce, PhpCommit, GoCommit, Snap, Model), run_nonce_observed(Run, Observed), Nonce != Observed.
requested: requested(Run, Req) :-
    replay_request(Run, Req, Tenant, Route, Op).
requested_closed: requested_closed(Run) :-
    replay_requests_closed(Run).
replayed: replayed(Run, Op) :-
    replay_request(Run, Req, Tenant, Route, Op).
// One family per implementation side. Expansion is syntactic and happens
// once at decode; every kernel sees only the expanded rules.
.template side(Side) {
    $Side_model_agree: $Side_model_agree(Run, Req) :-
        $Side_post_state(Run, Req, S), model_describes_run(M, Run), model_admissible(Run, M, Req, S).
    $Side_model_disagree: $Side_model_disagree(Run, Req, S) :-
        $Side_post_state(Run, Req, S), model_describes_run(M, Run), !model_admissible(Run, M, Req, S).
    $Side_observed: $Side_observed(Run, Req) :-
        $Side_post_state(Run, Req, S).
    $Side_observed_closed: $Side_observed_closed(Run) :-
        $Side_post_states_closed(Run).
    post_state_gap_$Side: post_state_gap(Run, Req, $Side::symbol) :-
        requested(Run, Req), replay_requests_closed(Run), !$Side_observed(Run, Req).
    exclusion_applied_$Side: exclusion_applied(Run, Op, Tb) :-
        replay_request(Run, Req, Tenant, Route, Op), $Side_effect(Run, Req, Tb, Kind, Pk, Cols), model_describes_run(M, Run), model_scope_excluded(M, Tb).
    undeclared_write_$Side: undeclared_write(Run, Op, Tb) :-
        replay_request(Run, Req, Tenant, Route, Op), $Side_effect(Run, Req, Tb, Kind, Pk, Cols), model_describes_run(M, Run), !model_writes(M, Op, Tb), model_scope_exclusions_closed(M), !model_scope_excluded(M, Tb).
    $Side_disagree_any: $Side_disagree_any(Run, Op) :-
        replay_request(Run, Req, Tenant, Route, Op), $Side_model_disagree(Run, Req, S).
    $Side_disagreement_closed: $Side_disagreement_closed(Run, Op) :-
        replayed(Run, Op), replay_run_current(Run), model_describes_run(M, Run), replay_requests_closed(Run), $Side_post_states_closed(Run), model_admissible_closed(Run, M).
    effect_order_violation_$Side: effect_order_violation(Run, $Side::symbol, Req, Ta, Tb) :-
        model_describes_run(M, Run), model_effect_seq(Run, M, Req, S1, Ta, Ka, Pa), model_effect_seq(Run, M, Req, S2, Tb, Kb, Pb), S1 < S2, $Side_effect_seq(Run, Req, O1, Ta, Ka, Qa), $Side_effect_seq(Run, Req, O2, Tb, Kb, Qb), O2 < O1.
    effect_order_respected_$Side: effect_order_respected(Run, $Side::symbol, Req) :-
        model_describes_run(M, Run), model_effect_seq(Run, M, Req, S1, Ta, Ka, Pa), model_effect_seq(Run, M, Req, S2, Tb, Kb, Pb), S1 < S2, $Side_effect_seq(Run, Req, O1, Ta, Ka, Qa), $Side_effect_seq(Run, Req, O2, Tb, Kb, Qb), O1 < O2.
    repeat_delete_has_effect_$Side: repeat_delete_has_effect(Run, Req) :-
        repeat_delete(Run, Req, T), $Side_effect(Run, Req, Tb, Kind, Pk, Cols), model_describes_run(M, Run), !model_scope_excluded(M, Tb).
    repeat_delete_violation_$Side: repeat_delete_violation(Run, Req, $Side::symbol) :-
        repeat_delete(Run, Req, T), first_delete_committed(Run, ReqF, T), $Side_response(Run, Req, St), St != 404::unsigned.
}
.instantiate side(php).
.instantiate side(go).
op_exercised: op_exercised(Run, Op) :-
    replay_request(Run, Req, Tenant, Route, Op), php_model_agree(Run, Req), go_model_agree(Run, Req).
post_state_any: post_state_any(Run, Op) :-
    replay_request(Run, Req, Tenant, Route, Op), post_state_gap(Run, Req, Side).
post_state_gap_closed: post_state_gap_closed(Run, Op) :-
    replayed(Run, Op), replay_requests_closed(Run), php_post_states_closed(Run), go_post_states_closed(Run).
model_scope_excluded: model_scope_excluded(M, Tb) :-
    model_scope_exclusion(M, Tb, Reason).
model_scope_excluded_closed: model_scope_excluded_closed(M) :-
    model_scope_exclusions_closed(M).
surviving_mutant: surviving_mutant(Run, Op, Mu) :-
    model_describes_run(M, Run), mutant(M, Mu, Op), mutants_closed(M, Op), !mutant_killed_in(Run, Mu).
op_has_surviving_mutant: op_has_surviving_mutant(Run, Op) :-
    surviving_mutant(Run, Op, Mu).
op_surviving_closed: op_surviving_closed(Run, Op) :-
    model_describes_run(M, Run), mutants_closed(M, Op), mutant_kills_closed(Run).
corpus_constrains: corpus_constrains(Run, Op) :-
    model_describes_run(M, Run), mutant(M, Mu, Op), !op_has_surviving_mutant(Run, Op).
kill_closure_gap: kill_closure_gap(Run, Mu, Req) :-
    mutant_killed(Run, Mu, Req), mutant_kills_closed(Run), !requested(Run, Req).
kill_closure_gap_any: kill_closure_gap_any(Run, Op) :-
    replayed(Run, Op), kill_closure_gap(Run, Mu, Req).
kill_gap_closed: kill_gap_closed(Run) :-
    mutant_kills_closed(Run), replay_requests_closed(Run).
undeclared_any: undeclared_any(Run, Op) :-
    undeclared_write(Run, Op, Tb).
undeclared_writes_closed: undeclared_writes_closed(Run, Op) :-
    replayed(Run, Op), replay_run_current(Run), model_describes_run(M, Run), replay_requests_closed(Run), php_effects_closed(Run), go_effects_closed(Run), model_writes_closed(M, Op), model_scope_exclusions_closed(M).
effect_order_any: effect_order_any(Run, Op) :-
    replay_request(Run, Req, Tenant, Route, Op), effect_order_violation(Run, Side, Req, Ta, Tb).
effect_order_exercised: effect_order_exercised(Run, Op) :-
    replay_request(Run, Req, Tenant, Route, Op), effect_order_respected(Run, "php"::symbol, Req), effect_order_respected(Run, "go"::symbol, Req).
effect_order_closed: effect_order_closed(Run, Op) :-
    replayed(Run, Op), replay_run_current(Run), model_describes_run(M, Run), replay_requests_closed(Run), php_effect_seqs_closed(Run), go_effect_seqs_closed(Run), model_effect_seqs_closed(Run, M).
delete_target: delete_target(Run, Req, Seq, Tenant, T) :-
    replay_request_seq(Run, Req, Seq, T), replay_request(Run, Req, Tenant, Route, "delete-issue"::symbol).
earlier_delete: earlier_delete(Run, Tenant, T, Seq) :-
    delete_target(Run, Req1, Seq1, Tenant, T), delete_target(Run, Req2, Seq, Tenant, T), Seq1 < Seq.
earlier_delete_closed: earlier_delete_closed(Run) :-
    replay_requests_closed(Run), replay_request_seqs_closed(Run).
first_delete_committed: first_delete_committed(Run, Req, T) :-
    delete_target(Run, Req, Seq, Tenant, T), !earlier_delete(Run, Tenant, T, Seq), php_response(Run, Req, 200::unsigned), go_response(Run, Req, 200::unsigned), php_effect(Run, Req, "issue"::symbol, "update"::symbol, Pk1, Cols1), go_effect(Run, Req, "issue"::symbol, "update"::symbol, Pk2, Cols2).
repeat_delete: repeat_delete(Run, Req, T) :-
    delete_target(Run, Req1, S1, Tenant, T), delete_target(Run, Req, S2, Tenant, T), S1 < S2.
repeat_delete_effects_closed: repeat_delete_effects_closed(Run) :-
    model_describes_run(M, Run), php_effects_closed(Run), go_effects_closed(Run), model_scope_exclusions_closed(M).
repeat_delete_not_found: repeat_delete_not_found(Run, T) :-
    repeat_delete(Run, Req, T), first_delete_committed(Run, ReqF, T), php_response(Run, Req, 404::unsigned), go_response(Run, Req, 404::unsigned), !repeat_delete_has_effect(Run, Req).
repeat_delete_violation_effects: repeat_delete_violation(Run, Req, "effects"::symbol) :-
    repeat_delete(Run, Req, T), first_delete_committed(Run, ReqF, T), repeat_delete_has_effect(Run, Req).
repeat_delete_any: repeat_delete_any(Run, Op) :-
    replay_request(Run, Req, Tenant, Route, Op), repeat_delete_violation(Run, Req, Side).
repeat_delete_closed: repeat_delete_closed(Run, Op) :-
    replayed(Run, Op), replay_run_current(Run), replay_requests_closed(Run), replay_request_seqs_closed(Run), php_responses_closed(Run), go_responses_closed(Run), php_effects_closed(Run), go_effects_closed(Run), model_describes_run(M, Run), model_scope_exclusions_closed(M).
oracle_unstable: oracle_unstable(Run) :-
    replay_stability(Run, RunA, RunB, Side, "false"::symbol).
oracle_unstable_closed: oracle_unstable_closed(Run) :-
    replay_stability_closed(Run).
oracle_stable: oracle_stable(Run) :-
    replay_stability(Run, RunA, RunB, "php"::symbol, "true"::symbol), replay_stability_closed(Run), !oracle_unstable(Run).
learn_predicted: learn_predicted(Run, Op) :-
    learn_prediction(Run, M, L, Tape, Req, Op, P, SD), P != "unknown"::symbol.
learn_counterexample: learn_counterexample(Run, Tape, Req, Op, P, O) :-
    learn_prediction(Run, M, L, Tape, Req, Op, P, SP), learn_observation(Run, Tape, Req, Op, O, SO), P != O, P != "unknown"::symbol.
learn_counterexample_any: learn_counterexample_any(Run, Op) :-
    learn_counterexample(Run, Tape, Req, Op, P, O).
learn_counterexample_closed: learn_counterexample_closed(Run, Op) :-
    learn_predicted(Run, Op), learn_run(Run, Camp, M, L, Php, Snap), model_describes_run(M, Run), learn_describes_model(L, M), learn_predictions_closed(Run, M), learn_observations_closed(Run).
learn_consistent: learn_consistent(Run, Op) :-
    learn_counterexample_closed(Run, Op), !learn_counterexample_any(Run, Op).
learn_unmodeled_any: learn_unmodeled_any(Run, Op) :-
    learn_run(Run, Camp, M, L, Php, Snap), model_describes_run(M, Run), learn_describes_model(L, M), learn_unmodeled_closed(M, L), learn_unmodeled(M, L, Op).
learn_unmodeled_gate_closed: learn_unmodeled_gate_closed(Run, Op) :-
    replayed(Run, Op), replay_run_current(Run).
op_qualified_rt: op_qualified_rt(IX, Run, Op) :-
    index_describes_replay(IX, Run), replayed(Run, Op), op_exercised(Run, Op), model_describes_run(M, Run), corpus_constrains(Run, Op), !php_disagree_any(Run, Op), !go_disagree_any(Run, Op), !undeclared_any(Run, Op), !post_state_any(Run, Op), !kill_closure_gap_any(Run, Op), !effect_order_any(Run, Op), effect_order_exercised(Run, Op), oracle_stable(Run), !repeat_delete_any(Run, Op), !learn_unmodeled_any(Run, Op), model_well_formed(M, Checker, Version, Binary, StructureCert), model_operation_checked(M, Op, Checker, Version, Binary, OperationCert), model_checker_admitted(M, Op, Checker, Version, Binary, OperationCert).
op_qualified: op_qualified(IX, Run, Op) :-
    op_declared(IX, Op), index_describes_replay(IX, Run), op_qualified_rt(IX, Run, Op).
