// Explicit scope mappings. Elaboration inserts missing obligations, never facts.
.completes learn_unmodeled_closed -> learn_unmodeled by model=model, learn=learn.
.completes model_writes_closed -> model_writes by model=model, op=op.
.completes mutants_closed -> mutant by model=model, op=op.
.completes model_scope_excluded_closed -> model_scope_excluded by model=model.
.completes model_scope_exclusions_closed -> model_scope_exclusion by model=model.
.completes learn_predictions_closed -> learn_prediction by run=run, model=model.
.completes model_admissible_closed -> model_admissible by run=run, model=model.
.completes model_effect_seqs_closed -> model_effect_seq by run=run, model=model.
.completes effect_order_closed -> effect_order_any by run=run, op=op.
.completes go_disagreement_closed -> go_disagree_any by run=run, op=op.
.completes learn_counterexample_closed -> learn_counterexample_any by run=run, op=op.
.completes learn_unmodeled_gate_closed -> learn_unmodeled_any by run=run, op=op.
.completes op_surviving_closed -> op_has_surviving_mutant by run=run, op=op.
.completes php_disagreement_closed -> php_disagree_any by run=run, op=op.
.completes post_state_gap_closed -> post_state_any by run=run, op=op.
.completes repeat_delete_closed -> repeat_delete_any by run=run, op=op.
.completes undeclared_writes_closed -> undeclared_any by run=run, op=op.
.completes earlier_delete_closed -> earlier_delete by run=run.
.completes go_effects_closed -> go_effect by run=run.
.completes go_effect_seqs_closed -> go_effect_seq by run=run.
.completes go_observed_closed -> go_observed by run=run.
.completes go_post_states_closed -> go_post_state by run=run.
.completes go_responses_closed -> go_response by run=run.
.completes kill_gap_closed -> kill_closure_gap_any by run=run.
.completes learn_observations_closed -> learn_observation by run=run.
.completes mutant_kills_closed -> mutant_killed_in by run=run.
.completes oracle_unstable_closed -> oracle_unstable by run=run.
.completes php_effects_closed -> php_effect by run=run.
.completes php_effect_seqs_closed -> php_effect_seq by run=run.
.completes php_observed_closed -> php_observed by run=run.
.completes php_post_states_closed -> php_post_state by run=run.
.completes php_responses_closed -> php_response by run=run.
.completes repeat_delete_effects_closed -> repeat_delete_has_effect by run=run.
.completes replay_requests_closed -> replay_request by run=run.
.completes replay_request_seqs_closed -> replay_request_seq by run=run.
.completes replay_stability_closed -> replay_stability by run=run.
.completes requested_closed -> requested by run=run.

.capability model_describes_run-endpoints witness model_describes_run model:model -> run:run left(model_well_formed, learn_unmodeled, mutant, model_writes, model_scope_exclusion, model_scope_excluded, model_checker_admitted, model_operation_checked) right(op_qualified, op_qualified_rt, learn_run, learn_prediction, model_effect_seq, model_admissible, model_effect, kill_closure_gap, mutant_killed, mutant_killed_in, replay_run_stale, replay_run, surviving_mutant, exclusion_applied, undeclared_write, learn_consistent, corpus_constrains, effect_order_any, effect_order_exercised, go_disagree_any, kill_closure_gap_any, learn_counterexample_any, learn_predicted, learn_unmodeled_any, op_exercised, op_has_surviving_mutant, php_disagree_any, post_state_any, repeat_delete_any, replayed, undeclared_any, go_effect_seq, php_effect_seq, replay_request_seq, delete_target, post_state_gap, repeat_delete_violation, go_model_disagree, php_model_disagree, go_post_state, php_post_state, go_response, php_response, go_effect, php_effect, first_delete_committed, repeat_delete, replay_request, go_model_agree, go_observed, php_model_agree, php_observed, repeat_delete_has_effect, requested, replay_stability, effect_order_violation, effect_order_respected, learn_observation, learn_counterexample, repeat_delete_not_found, earlier_delete, oracle_stable, oracle_unstable, replay_run_current).
.bridge model-run model -> run.
.capability index_describes_replay-endpoints witness index_describes_replay index:index -> run:run left(op_qualified, op_qualified_rt, op_declared) right(op_qualified, op_qualified_rt, learn_run, learn_prediction, model_effect_seq, model_admissible, model_effect, kill_closure_gap, mutant_killed, mutant_killed_in, replay_run_stale, replay_run, surviving_mutant, exclusion_applied, undeclared_write, learn_consistent, corpus_constrains, effect_order_any, effect_order_exercised, go_disagree_any, kill_closure_gap_any, learn_counterexample_any, learn_predicted, learn_unmodeled_any, op_exercised, op_has_surviving_mutant, php_disagree_any, post_state_any, repeat_delete_any, replayed, undeclared_any, go_effect_seq, php_effect_seq, replay_request_seq, delete_target, post_state_gap, repeat_delete_violation, go_model_disagree, php_model_disagree, go_post_state, php_post_state, go_response, php_response, go_effect, php_effect, first_delete_committed, repeat_delete, replay_request, go_model_agree, go_observed, php_model_agree, php_observed, repeat_delete_has_effect, requested, replay_stability, effect_order_violation, effect_order_respected, learn_observation, learn_counterexample, repeat_delete_not_found, earlier_delete, oracle_stable, oracle_unstable, replay_run_current).
.bridge index-run index -> run.

