 "executor_classes": {
  "model": "Shen reference model execution",
  "fake": "Synthetic in-process adapter or service substitute; never called a legacy or target implementation",
  "real-service": "Pinned real service or deployed implementation behind an enforced adapter",
  "none": "No implementation is executed; checker, schema or proof work"
 },
 "work_packages": {
  "W0": "Baseline and validation",
  "B1": "Domain language and model variants",
  "W1": "Evidence/checker contracts",
  "B2": "Checked rules and behavior composition",
  "W3": "Checked compiler transformations",
  "W2": "Typed claims and authority",
  "B3": "Model execution, generation and correspondence",
  "W6": "Production adapter enforcement",
  "B4": "Migration contracts and three-way qualification",
  "W4": "Quantified/structural induction",
  "W5": "General frames and completion",
  "W7": "Deterministic controls and replay",
  "W8": "Concurrency and temporal properties",
  "W9": "Complete application migration",
  "W10": "Performance and incrementality",
  "W11": "Release qualification"
 },
 "conditions": {
  "multi-store-observation": {
   "applies_to": "inventory-entry",
   "description": "The observation map reads more than one store, or any store with asynchronous workers or TTL.",
   "any_of": [
    {"field": "observation_stores", "test": "count_gt", "value": 1},
    {"field": "observation_stores", "test": "any_flag", "flag": "async_or_ttl"}
   ]
  },
  "concurrent-or-retry": {
   "applies_to": "inventory-entry",
   "description": "Two or more commands can be in flight concurrently, or an info-able step is followed by a retry.",
   "any_of": [
    {"field": "max_concurrent_commands", "test": "gt", "value": 1},
    {"field": "info_step_then_retry", "test": "true"}
   ]
  },
  "unbounded-progress": {
   "applies_to": "claim",
   "description": "A progress or liveness claim beyond a bounded campaign, needing ranking or well-founded arguments.",
   "any_of": [
    {"field": "claims_unbounded_progress", "test": "true"}
   ]
  },
  "replay-claims": {
   "applies_to": "claim",
   "description": "A projection or targeting result is reported as a replayable execution claim.",
   "any_of": [
    {"field": "reported_as_replay", "test": "true"}
   ]
  },
  "advertised": {
   "applies_to": "release",
   "description": "The capability is part of the release's advertised scope.",
   "any_of": [
    {"field": "advertised", "test": "true"}
   ]
  }
 },
